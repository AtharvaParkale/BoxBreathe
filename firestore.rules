rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid} — profile doc, created on first sign-in.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'displayName', 'email', 'photoUrl', 'provider',
             'createdAt', 'lastActiveAt', 'onboardingComplete',
           ])
        && request.resource.data.provider in ['anonymous', 'google']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastActiveAt is timestamp
        && request.resource.data.onboardingComplete is bool;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'displayName', 'email', 'photoUrl', 'provider',
             'createdAt', 'lastActiveAt', 'onboardingComplete',
           ])
        && request.resource.data.provider in ['anonymous', 'google']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastActiveAt is timestamp
        && request.resource.data.onboardingComplete is bool;

      allow delete: if isOwner(uid);

      // users/{uid}/sessions/{sessionId} — append-only completed-session
      // history. No update/delete: sessions are a log, not editable state.
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'techniqueId', 'techniqueName', 'durationSeconds',
               'completedDurationSeconds', 'startedAt', 'completedAt',
               'completed', 'dateKeyLocal', 'source',
             ])
          && request.resource.data.techniqueId is string
          && request.resource.data.techniqueName is string
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0
          && request.resource.data.completedDurationSeconds is int
          && request.resource.data.completedDurationSeconds >= 0
          && request.resource.data.startedAt is timestamp
          && request.resource.data.completedAt is timestamp
          && request.resource.data.completed is bool
          && request.resource.data.dateKeyLocal is string
          && request.resource.data.source in ['android', 'ios'];

        allow update, delete: if false;
      }

      // users/{uid}/preferences/settings — single doc, mirrors local Hive
      // settings for cross-device sync.
      match /preferences/{prefDoc} {
        allow read: if isOwner(uid);

        allow write: if isOwner(uid)
          && prefDoc == 'settings'
          && request.resource.data.keys().hasOnly([
               'isSoundEnabled', 'soundCue', 'isHapticEnabled',
               'dailyReminderHour', 'dailyReminderMinute', 'updatedAt',
             ])
          && request.resource.data.isSoundEnabled is bool
          && request.resource.data.soundCue is string
          && request.resource.data.isHapticEnabled is bool
          && request.resource.data.dailyReminderHour is int
          && request.resource.data.dailyReminderMinute is int
          && request.resource.data.updatedAt is timestamp;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
